# Для app (подключение к БД)
APP_POSTGRES_SERVER=db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${APP_POSTGRES_SERVER}:5432/${POSTGRES_DB}
