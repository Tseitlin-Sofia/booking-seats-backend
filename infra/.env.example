# Настройки приложения
APP_TITLE=Кафффетерий
DESCRIPTION=Сервис бронирования столиков в кафе
SECRET=SECRET
FIRST_SUPERUSER_EMAIL=ya@ya.ru
FIRST_SUPERUSER_PASSWORD=admin

# Общие настройки для БД
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db
